# Copy to apps/server/.env and fill in real values.
# Generate BETTER_AUTH_SECRET with: openssl rand -base64 32

DATABASE_URL=postgresql://ji_app:ji_app_local@127.0.0.1:5432/ji_test
MIGRATION_DATABASE_URL=postgresql://ji_migrator:ji_migrator_local@127.0.0.1:5432/ji_test
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development

# Search index (U6). Compose defaults to http://127.0.0.1:9308 on the host.
MANTICORE_URL=http://127.0.0.1:9308

# Local raw-object store for ingest smoke (defaults to .data/raw-objects under cwd).
# Filesystem is used only when RAW_S3_BUCKET is unset — production refuses to
# start on the filesystem backend (RJC-386).
RAW_OBJECT_STORE_PATH=

# Durable S3-compatible raw object store (RJC-386). Setting RAW_S3_BUCKET
# selects it over RAW_OBJECT_STORE_PATH above. Local defaults below point at
# the `raw-storage-minio` Compose service: `docker compose --profile storage
# up -d --wait raw-storage-minio raw-storage-minio-init` (bucket ji-raw-local
# is created automatically). minioadmin/minioadmin are MinIO's well-known
# local-only defaults — never use them against a real bucket.
# RAW_S3_BUCKET=ji-raw-local
# RAW_S3_ENDPOINT=http://127.0.0.1:9002
# RAW_S3_REGION=us-east-1
# RAW_S3_ACCESS_KEY_ID=minioadmin
# RAW_S3_SECRET_ACCESS_KEY=minioadmin

# Optional read-only Motian-Neon source for U8 backfill (never commit real values).
# Used only by scripts/backfill-neon-v1.ts and the backfill-neon-v1 worker task.

# Slice B — Spott.io REST export (optional until export is enabled)
# Set SPOTT_LIVE=1 to call https://api.gospott.com instead of repo fixtures.
SPOTT_API_KEY=
