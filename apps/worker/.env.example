# Copy to apps/worker/.env and fill in real values from the Trigger.dev dashboard.
# Project: catapulze-job-intelligence (TSG-DEV / rjct-lab-d543)
# https://cloud.trigger.dev/orgs/rjct-lab-d543/projects/catapulze-job-intelligence-Yw1m/env/dev

TRIGGER_PROJECT_REF=proj_xgtjezribvfwcmqktcli
TRIGGER_SECRET_KEY=tr_dev_replace_me

# Deploy after setting TRIGGER_SECRET_KEY locally: bun run deploy (from apps/worker)

# Postgres + search (same as apps/server for local smoke)
# Production Trigger cutover (static IPs + FW + DATABASE_URL): docs/runbooks/trigger-on-box-cutover.md
DATABASE_URL=postgresql://ji_app:ji_app_local@127.0.0.1:5432/ji_test
MANTICORE_URL=http://127.0.0.1:9308
# Only relevant while this worker drains inline; must match the search schema.
SEARCH_HYBRID=0

# EffectTS production enablement (CTP-479 / Slice 14) — default OFF.
# Worker canary: JI_EFFECT_WORKER=1 → Effect task-body boundary (Trigger durability unchanged).
JI_EFFECT_WORKER=0
JI_EFFECT_SEARCH=0
PERF_EFFECT_SPANS=0

# RJC-387: who drains the curated outbox into Manticore after a bron run.
# "worker" (default, unset) is today's behaviour — this process drains
# inline and needs MANTICORE_URL. "onbox" defers entirely to the standalone
# projector process (apps/server, `bun run projector`) running next to
# Manticore, so this worker never needs a route to a private Manticore.
# Production runs onbox — see docs/runbooks/search-projector.md.
# SEARCH_PROJECTOR=onbox

# Local raw-object store for ingest smoke (defaults to .data/raw-objects under
# cwd). Filesystem is used only when RAW_S3_BUCKET is unset (RJC-386) — see
# apps/server/.env.example for the durable S3 backend and how it must match
# whatever the server is configured with (worker and server share one store).
RAW_OBJECT_STORE_PATH=
# RAW_S3_BUCKET=ji-raw-local
# RAW_S3_ENDPOINT=http://127.0.0.1:9002
# RAW_S3_REGION=us-east-1
# RAW_S3_ACCESS_KEY_ID=minioadmin
# RAW_S3_SECRET_ACCESS_KEY=minioadmin

# Live connector opt-in (leave unset in CI; fixtures used when unset)
TENDER_NED_LIVE=
INHUURDESK_LIVE=
BLUETRAIL_LIVE=
CTM_LIVE=
FLINTER_LIVE=
HARVEYNASH_LIVE=
HERO_LIVE=
NEEDSTAFFING_LIVE=
ONEFELLOW_LIVE=
OPDRACHTOVERHEID_LIVE=
PROACT_LIVE=
STRIIVE_LIVE=
