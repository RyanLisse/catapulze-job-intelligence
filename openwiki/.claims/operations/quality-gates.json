          "version": "repo-lines-v1:sha256:55fbf915c12b2292c9dcd687258c079533efba5a584134eec193bbdf2dc415a1:"
        }
      ]
    },
    {
      "id": "claim_4d5a82ccaa9a4880b92d4863f5bcd045",
      "statement": "Lefthook is the sole owner of `.git/hooks`; `bun install` runs `lefthook install --reset-hooks-path` via the prepare script, and `qlty githooks install` must never be run.",
