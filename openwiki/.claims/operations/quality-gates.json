    },
    {
      "id": "claim_e563514da0a045f9a0cd591c88e86e93",
      "statement": "Pre-commit runs three parallel jobs: a wiki-guard that refuses commits mixing `openwiki/` with non-wiki source, `ultracite fix` on staged TS/JS/JSON/YAML (excluding docs/openwiki/verify-skill), and `qlty check` on staged YAML/sh and `.github/**`.",
      "evidence": [
        {
          "resource": "repo://lefthook.yml#L5-L27",
          "version": "repo-lines-v1:sha256:2248860de4800831d5bef3720315d9bcdd3391d0aed5510a49d54ad591b0fbdc:"
