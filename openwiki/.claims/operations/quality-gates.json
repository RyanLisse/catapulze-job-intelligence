  "claims": [
    {
      "id": "claim_8758437079c94941903c903dabf8f460",
      "statement": "Quality is driven by npm scripts in package.json that delegate to shell helpers under tools/quality: `bun run fix` (fix-changed.sh) auto-fixes changed files, `bun run check` (check-changed.sh) lints changed files plus Qlty, `bun run gate` (gate.sh) runs the full pre-push gate, and `fix:all`/`check:all` are whole-tree escape hatches.",
      "evidence": [
        {
          "resource": "repo://package.json#L68-L75",
          "version": "repo-lines-v1:sha256:49a27f4db15a7c73f415ee0db6fbc2626858a1f6960e3b7e54e4ff085b6b0bd5:"
        }
      ]
    },
    {
      "id": "claim_39aa5f4c24d043c99877ffbbd0447449",
      "statement": "`fix` and `check` are scoped to the union of branch, staged, unstaged, and untracked changes vs `origin/main` (or `$QUALITY_BASE_REF`) via tools/quality/resolve-changed.sh; they never fall back to the whole tree and exclude `docs/` and `openwiki/` by policy.",
      "evidence": [
        {
          "resource": "repo://tools/quality/resolve-changed.sh#L10-L64",
          "version": "repo-lines-v1:sha256:0c16c4174383e59c552f5f38703592b6f7eb2d7a59b0c446eb00957f92c6c9d7:"
        }
      ]
    },
    {
      "id": "claim_f8039019c6344bed8e62430a11260d06",
      "statement": "Qlty CLI is required for `bun run check` and `bun run gate`; both fail intentionally when Qlty is missing so a missing quality-owner is never reported green.",
      "evidence": [
        {
          "resource": "repo://tools/quality/check-changed.sh#L48-L55",
