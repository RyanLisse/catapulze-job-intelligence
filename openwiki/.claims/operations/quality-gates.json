        }
      ]
    },
    {
      "id": "claim_c07afc1d201c4ede99fdd68c6555414c",
      "statement": "Pre-push runs gate.sh as a script job rather than a command job, because lefthook skips command jobs with 'no matching push files' and builds its push list without deletions — a deletion-only push once landed ungated (CTP-503).",
      "evidence": [
        {
          "resource": "repo://lefthook.yml#L28-L35",
          "version": "repo-lines-v1:sha256:f04161b6fe0ea335292affd9614fa61120d9b6d8ce3cc935551e0b05cb1915f7:"
        }
