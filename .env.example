# Docker Compose defaults for the isolated local P0 database.
# Production values belong in the deployment secret manager, not in git.

POSTGRES_ADMIN_USER=ji_admin
POSTGRES_ADMIN_PASSWORD=ji_admin_local
POSTGRES_DB=ji_test
POSTGRES_MIGRATOR_USER=ji_migrator
POSTGRES_MIGRATOR_PASSWORD=ji_migrator_local
POSTGRES_APP_USER=ji_app
POSTGRES_APP_PASSWORD=ji_app_local
POSTGRES_HOST_PORT=5432
POSTGRES_DATA_VOLUME=catapulze-postgres-p0

# The server container connects over the private Compose network.
CATAPULZE_DATABASE_URL=postgresql://ji_app:ji_app_local@postgres:5432/ji_test
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# Local defaults are intentionally modest. The production runbook starts with
# a larger Postgres budget and keeps Manticore rebuildable and lower priority.
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=4g
POSTGRES_MEMORY_RESERVATION=1g
POSTGRES_SHM_SIZE=512m
